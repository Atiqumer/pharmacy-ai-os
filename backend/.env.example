# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database?sslmode=require

# Groq AI configuration
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT secret for auth tokens (change in production!)
JWT_SECRET=your-super-secret-key-change-this

# Token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Set to smtp in production. Development mode returns a token only outside production.
PASSWORD_RESET_DELIVERY=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_SSL=false
